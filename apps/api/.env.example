# Host development for the MANA web app and API.
# For a provider-free local install, run sh scripts/self-host.sh from the repo root; it generates
# secrets and starts its own database, S3-compatible storage, and Mailpit inbox.
NODE_ENV=development
DEPLOYMENT_MODE=self-hosted
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freelanceos
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-local-secret
BETTER_AUTH_URL=http://localhost:4000
PORT=4000

# Host development storage. Replace these placeholders with the credentials for your
# local S3-compatible service, or use the self-hosting script for an included service.
R2_ENDPOINT=http://localhost:39000
R2_PRESIGN_ENDPOINT=http://localhost:39000
R2_REGION=us-east-1
R2_FORCE_PATH_STYLE=true
R2_ACCESS_KEY_ID=local-development-access-key
R2_SECRET_ACCESS_KEY=replace-with-a-local-secret
R2_BUCKET_NAME=mana
R2_PUBLIC_BUCKET_NAME=mana-public
R2_PUBLIC_URL=http://localhost:39000/mana-public

# Mailpit captures verification messages locally. Set RESEND_* instead when testing
# real outbound delivery.
MAILPIT_URL=http://localhost:38025

# Optional AI. Set ANTHROPIC_BASE_URL and ANTHROPIC_API_KEY together when using an
# Anthropic-compatible provider; omit them to keep core workflows available.
# ANTHROPIC_BASE_URL=http://localhost:11434
# ANTHROPIC_API_KEY=
# AI_MODEL=kimi-k2.6

# Optional sign-in and integrations.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# GROQ_API_KEY=
# TYPHOON_OCR_API_KEY=
# THUNDER_API_KEY=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# LINE_OA_ID=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# CRON_SECRET=
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

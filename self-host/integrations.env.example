# Copy to .env.selfhost.integrations at the repository root, then uncomment only
# the integrations you configure. Never commit this file with real credentials.
# Set the endpoint, key, and model together for your Anthropic-compatible provider.
# ANTHROPIC_BASE_URL=https://provider.example/anthropic
# ANTHROPIC_API_KEY=replace-with-provider-key
# AI_MODEL=your-provider-model-id

# OAuth callback URLs use http://localhost:3300/api/auth/callback/<provider>.
# GOOGLE_CLIENT_ID=replace-with-client-id
# GOOGLE_CLIENT_SECRET=replace-with-client-secret
# DISCORD_CLIENT_ID=replace-with-client-id
# DISCORD_CLIENT_SECRET=replace-with-client-secret
# FACEBOOK_CLIENT_ID=replace-with-client-id
# FACEBOOK_CLIENT_SECRET=replace-with-client-secret
